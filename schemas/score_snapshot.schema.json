{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://veriswarm.ai/schemas/score_snapshot.schema.json",
  "title": "ScoreSnapshot",
  "description": "Response of GET /v1/public/agents/{agent_id}/scores/current.",
  "type": "object",
  "required": [
    "identity",
    "risk",
    "reliability",
    "autonomy",
    "policy_tier"
  ],
  "properties": {
    "identity": {
      "type": "object",
      "required": [
        "score",
        "confidence"
      ],
      "properties": {
        "score": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "risk": {
      "type": "object",
      "required": [
        "score",
        "confidence"
      ],
      "properties": {
        "score": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "band": {
          "type": "string",
          "enum": [
            "low",
            "moderate",
            "high",
            "severe"
          ]
        }
      }
    },
    "reliability": {
      "type": "object",
      "required": [
        "score",
        "confidence"
      ],
      "properties": {
        "score": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "autonomy": {
      "type": "object",
      "required": [
        "score",
        "confidence",
        "label"
      ],
      "properties": {
        "score": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "label": {
          "type": "string",
          "enum": [
            "agent_operated",
            "human_assisted",
            "unclear"
          ]
        }
      }
    },
    "calibration": {
      "type": "object",
      "required": [
        "score",
        "confidence"
      ],
      "properties": {
        "score": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "description": "Fifth trust dimension (Brier-score calibration). Absent for cold-start agents below the minimum matched-pairs threshold; the composite then uses the four established dimensions."
    },
    "policy_tier": {
      "type": "string",
      "enum": [
        "tier_0",
        "tier_1",
        "tier_2",
        "tier_3",
        "tier_x"
      ]
    },
    "explanations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
